<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp"
    android:layout_margin="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Social Shield"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a style to respond."
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:textAlignment="center"
        android:layout_gravity="center_horizontal"/>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnEnthusiastic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎉 Hell Yes!"
            android:textAllCaps="false"
            android:textColor="#AF52DE"
            android:backgroundTint="#1AAF52DE"
            android:layout_marginBottom="12dp"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnCasual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👍 Casual Accept"
            android:textAllCaps="false"
            android:textColor="#34C759"
            android:backgroundTint="#1A34C759"
            android:layout_marginBottom="12dp"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnHardPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛑 Hard Pass"
            android:textAllCaps="false"
            android:textColor="#FF3B30"
            android:backgroundTint="#1AFF3B30"
            android:layout_marginBottom="12dp"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnReschedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Reschedule"
            android:textAllCaps="false"
            android:textColor="#FF9500"
            android:backgroundTint="#1AFF9500"
            android:layout_marginBottom="12dp"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnProfessional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💼 Professional"
            android:textAllCaps="false"
            android:textColor="#007AFF"
            android:backgroundTint="#1A007AFF"
            android:layout_marginBottom="12dp"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnSoftDecline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💛 Soft Decline"
            android:textAllCaps="false"
            android:textColor="#FFCC00"
            android:backgroundTint="#1AFFCC00"
            android:layout_marginBottom="16dp"
            android:padding="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#007AFF" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crafting response..."
            android:textColor="#555555"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#888888"
        android:background="@android:color/transparent"/>

</LinearLayout>
