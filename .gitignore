.tokens

# User-specific files
*.suo
*.user
.vs/

# ============================================================================
# PROJECT SPECIFIC - Zeno Mobile App
# ============================================================================
# Don't ignore the Google OAuth config in root (it's the public client ID)
# But ignore any local secrets
!client_secret_*.json
client_secret_*.json.local
local_credentials/

# Gradle wrapper
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Maven wrapper
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ============================================================================
# DEVELOPMENT ONLY (can uncomment if needed)
# ============================================================================
# Temporary development files
*.tmp
*.temp
.debug
debug_logs/

# IDE temporary files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
